{
  "name": "vuetify-app-kit",
  "version": "1.0.0",
  "description": "Layouts, theme, shared components and app utilities for Vue 3 + Vuetify 4 applications",
  "license": "MIT",
  "author": "DAZZA DEV",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dazza-dev/vuetify-app-kit.git"
  },
  "homepage": "https://github.com/dazza-dev/vuetify-app-kit#readme",
  "bugs": {
    "url": "https://github.com/dazza-dev/vuetify-app-kit/issues"
  },
  "keywords": [
    "vue",
    "vuetify",
    "theme",
    "layout",
    "components",
    "starter-kit"
  ],
  "type": "module",
  "main": "./dist/vuetify-app-kit.js",
  "module": "./dist/vuetify-app-kit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vuetify-app-kit.js",
      "default": "./dist/vuetify-app-kit.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "default": "./dist/editor.js"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/vuetify-app-kit.css"
    },
    "./variables.scss": "./src/assets/scss/_variables.scss"
  },
  "files": [
    "dist",
    "src/assets/scss/_variables.scss"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "dev": "vite build --watch",
    "lint": "eslint src/ --ext .ts,.vue --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\"",
    "type-check": "vue-tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@sentry/vue": "^10.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-table-cell": "^3.0.0",
    "@tiptap/extension-table-header": "^3.0.0",
    "@tiptap/extension-table-row": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/vue-3": "^3.0.0",
    "pinia": "^3.0.4",
    "remixicon": "^4.0.0",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.5",
    "vue-router": "^5.1.0",
    "vue-tabler-icons": "^2.21.0",
    "vuetify": "4.1.1"
  },
  "peerDependenciesMeta": {
    "@sentry/vue": {
      "optional": true
    },
    "@tiptap/extension-table": {
      "optional": true
    },
    "@tiptap/extension-table-cell": {
      "optional": true
    },
    "@tiptap/extension-table-header": {
      "optional": true
    },
    "@tiptap/extension-table-row": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@tiptap/vue-3": {
      "optional": true
    },
    "remixicon": {
      "optional": true
    }
  },
  "dependencies": {
    "vue3-perfect-scrollbar": "^2.0.0"
  },
  "devDependencies": {
    "@sentry/vue": "^10.53.1",
    "@tiptap/extension-table": "^3.26.0",
    "@tiptap/extension-table-cell": "^3.26.0",
    "@tiptap/extension-table-header": "^3.26.0",
    "@tiptap/extension-table-row": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@tiptap/vue-3": "^3.26.0",
    "@types/node": "^25.9.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "prettier": "^3.8.3",
    "remixicon": "^4.9.1",
    "sass": "^1.100.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vue-i18n": "^11.4.5",
    "vue-tsc": "^3.3.4"
  }
}
